# PostgreSQL connection. On a Homebrew Mac install you are the superuser,
# so the app signs in as your macOS username with no password. Only set
# PGUSER / PGPASSWORD if your PostgreSQL was installed some other way.
PGHOST=localhost
PGPORT=5432
PGDATABASE=civicsense
# PGUSER=
# PGPASSWORD=

# Any long random string. Changing it signs everyone out.
SESSION_SECRET=replace-with-a-long-random-string
